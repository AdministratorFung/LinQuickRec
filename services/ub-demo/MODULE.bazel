module(name = "ub_demo", version = "0.1.0")

# Import brpc — all transitive deps (rules_cc, rules_proto, protobuf, etc.)
# are resolved automatically by Bzlmod from brpc's own MODULE.bazel.
# No need to declare them as direct deps — avoids MVS version conflicts.
bazel_dep(name = "brpc", version = "1.15.0")

# Override with local fork — edit this path before building
local_path_override(
    module_name = "brpc",
    path = "/path/to/brpc-fork",
)

# Inherit brpc's local deps extension (ubsocket, urma, etc.)
local_deps = use_extension("@brpc//:local_deps_ext.bzl", "local_deps")
use_repo(
    local_deps,
    "ubsocket",
    "urma",
    "libboundscheck",
    "boringssl",
)
